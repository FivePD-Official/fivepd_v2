<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>FivePD.Server.net</AssemblyName>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
        <AssemblyTitle>FivePD.Server</AssemblyTitle>
        <Product>FivePD.Server</Product>
        <Description>FivePD Server</Description>
        <Copyright>Copyright © FivePD 2023</Copyright>
        <AssemblyVersion>2.0.0</AssemblyVersion>
        <FileVersion>2.0.0</FileVersion>
        <DebugType>none</DebugType>
        <BuildDependsOn>$(BuildDependsOn);AfterBuildMigrated</BuildDependsOn>
        <LangVersion>latest</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Configurations>Release;Debug</Configurations>
        <Platforms>x64;AnyCPU</Platforms>
        <TargetFramework>netstandard2.0</TargetFramework>
        <DefineConstants>IS_GAMEMODE_SERVER</DefineConstants>
        <RootNamespace>FivePD.Server</RootNamespace>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
        <OutputPath>$(SolutionDir)/dev/FXServer-Data/resources/fivepd/Libraries/FivePD.Server</OutputPath>
        <PostBuildEvent Condition=" '$(OS)' != 'Unix' ">powershell.exe -NoProfile $(SolutionDir)\scripts\RestartLocalFXServer.ps1</PostBuildEvent>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
        <OutputPath>$(SolutionDir)/build-public/Libraries/FivePD.Server</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <OutputPath>../build-public/Libraries/FivePD.Server</OutputPath>
    </PropertyGroup>
    <Import Project="..\FivePD.Common\FivePD.Common.projitems" Label="Shared" />

    <!-- Remove automatically generated files -->
    <Target Name="RemoveGeneratedFiles" AfterTargets="Build">
        <ItemGroup>
            <RemovableGeneratedFiles Include="$(OutDir)*.json;$(OutDir)*.xml" />
        </ItemGroup>
        <Delete Files="@(RemovableGeneratedFiles)" />
    </Target>

    <!-- Make internals visible to the unit test project -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>FivePD.UnitTests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

    <!-- Copy static files to respective directories -->
    <ItemGroup>
        <StaticFiles Include="..\FivePD.Statics\**\*.*" />
    </ItemGroup>
    <Target Name="CopyStatics" BeforeTargets="CopyFilesToOutputDirectory" DependsOnTargets="CopyStaticsDebug;CopyStaticsRelease" />
    <Target Name="CopyStaticsDebug" Condition=" '$(Configuration)' == 'Debug' ">
        <Copy SourceFiles="@(StaticFiles)" DestinationFiles="@(StaticFiles->'$(ProjectDir)..\..\dev\FXServer-Data\resources\fivepd\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
    <Target Name="CopyStaticsRelease" Condition=" '$(Configuration)' == 'Release' ">
        <Copy SourceFiles="@(StaticFiles)" DestinationFiles="@(StaticFiles->'$(ProjectDir)..\..\build-public\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.24" />
        <PackageReference Include="CitizenFX.Core.Server" Version="1.0.8085" />
        <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[3.1.32]" allowedVersions="[3.1.32]" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[3.1.32]" allowedVersions="[3.1.32]" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="[3.1.32]" allowedVersions="[3.1.32]">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" />
        <PackageReference Include="MySqlConnector" Version="2.3.5" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" Cop="false" />
        <PackageReference Include="PolySharp" Version="1.8.3">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Scrutor" Version="4.1.0" />
        <PackageReference Include="Serilog" Version="2.10.1-dev-01343" />
        <PackageReference Include="Serilog.Sinks.Console" Version="4.0.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
        <PackageReference Update="SonarAnalyzer.CSharp" Version="8.36.1.44192" />
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.2.32">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="YamlDotNet" Version="13.1.1" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="CitizenFX.Core.Server, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null">
            <Private>True</Private>
            <Aliases Condition="$(DefineConstants.Contains(IS_GAMEMODE_CLIENT))">CfxServer</Aliases>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="obj\x64\Debug\.NETFramework,Version=v4.0.AssemblyAttributes.cs" />
        <Compile Remove="obj\x64\Debug\.NETFramework,Version=v4.7.2.AssemblyAttributes.cs" />
        <Compile Remove="obj\x64\Release\.NETFramework,Version=v4.0.AssemblyAttributes.cs" />
        <Compile Remove="obj\x64\Release\.NETFramework,Version=v4.7.2.AssemblyAttributes.cs" />
        <Compile Remove="obj\x64\Debug\netcoreapp2.1\FivePD.Server.AssemblyInfo.cs" />
        <Compile Remove="obj\x64\Debug\netcoreapp2.1\FivePD.ServerLegacy.AssemblyInfo.cs" />
        <Compile Remove="obj\x64\Release\net452\FivePD.Server.AssemblyInfo.cs" />
        <Compile Remove="obj\x64\Release\net472\FivePD.Server.AssemblyInfo.cs" />
        <Compile Remove="obj\x64\Release\netstandard2.0\FivePD.Server.AssemblyInfo.cs" />
    </ItemGroup>
    <ItemGroup>
      <Content Include="..\FivePD.Statics\eula.txt">
        <Link>FivePD.Statics\eula.txt</Link>
      </Content>
    </ItemGroup>
</Project>