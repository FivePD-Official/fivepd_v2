<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>FivePD.Gamemode.Client.net</AssemblyName>
    <TargetFramework>net452</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifiers>win</RuntimeIdentifiers>
    <AssemblyTitle>FivePD.Gamemode.Client</AssemblyTitle>
    <Product>FivePD.Gamemode.Client</Product>
    <Description>The FivePD Gamemode Clientside Library</Description>
    <Copyright>Copyright © GTAPoliceMods 2021</Copyright>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <DebugType>none</DebugType>
    <BuildDependsOn>$(BuildDependsOn);AfterBuildMigrated</BuildDependsOn>
    <LangVersion>8</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>../FXServer-Data/resources/fivepd/Libraries/FivePD.Gamemode.Client</OutputPath>
    <PostBuildEvent Condition=" '$(OS)' != 'Unix' ">powershell.exe $(SolutionDir)\Scripts\RestartLocalFXServer.ps1</PostBuildEvent>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>../build-public/Libraries/FivePD.Gamemode.Client</OutputPath>
  </PropertyGroup>
  <Import Project="..\FivePD.Common\FivePD.Common.projitems" Label="Shared" />
  <Target Name="AfterBuildMigrated">
    <Delete Files="$(OutDir)null.xml" />
  </Target>
  <ItemGroup>
    <Reference Include="CitizenFX.Core.Client, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null">
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CitizenFX.Core.Client" Version="1.0.5181" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Interfaces" />
    <Folder Include="Services" />
  </ItemGroup>
</Project>